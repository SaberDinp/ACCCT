{
  "name": "accc-telemetry",
  "productName": "ACCC Telemetry",
  "version": "1.2.4",
  "description": "Recorded-lap analysis and comparison for console racers, by Rice Racing",
  "author": "Rice Racing",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack:mac": "electron-builder --mac dmg zip --publish never",
    "pack:win": "electron-builder --win nsis zip --x64 --publish never",
    "pack:mac:arm64": "electron-builder --mac dmg zip --arm64 --publish never",
    "pack:mac:x64": "electron-builder --mac dmg zip --x64 --publish never",
    "pack:linux": "electron-builder --linux AppImage deb rpm tar.gz --x64 --arm64 --publish never",
    "pack:linux:x64": "electron-builder --linux AppImage deb rpm tar.gz --x64 --publish never",
    "pack:linux:arm64": "electron-builder --linux AppImage deb rpm tar.gz --arm64 --publish never",
    "prepack:linux": "node prepare_linux_packaging.cjs",
    "prepack:linux:x64": "node prepare_linux_packaging.cjs",
    "prepack:linux:arm64": "node prepare_linux_packaging.cjs"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "playwright": "1.65.0"
  },
  "build": {
    "appId": "com.accctelemetry.desktop",
    "productName": "ACCC Telemetry",
    "directories": {
      "output": "../dist",
      "buildResources": "icons"
    },
    "files": [
      "main.cjs",
      "backend-process.cjs",
      "loading.html",
      "package.json",
      "settings.cjs",
      "preferences.cjs",
      "preload.cjs",
      "icons/icon.png"
    ],
    "asar": true,
    "beforePack": "./before-pack.cjs",
    "artifactName": "ACCC-Telemetry-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.sports",
      "minimumSystemVersion": "14.0",
      "icon": "icons/icon.icns",
      "identity": "-",
      "extraResources": [
        {
          "from": "build/backend-macos-${arch}/accc-backend",
          "to": "backend"
        }
      ],
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "ACCC Telemetry",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "icons/icon.ico",
      "signExecutable": false,
      "extraResources": [
        {
          "from": "build/backend-windows",
          "to": "backend"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ACCC Telemetry",
      "deleteAppDataOnUninstall": false,
      "allowElevation": false,
      "runAfterFinish": true
    },
    "linux": {
      "executableName": "accc-telemetry",
      "icon": "icons/icon.png",
      "category": "Utility",
      "synopsis": "ACC Console Telemetry",
      "description": "Recorded-lap analysis and comparison for console racers, by Rice Racing",
      "maintainer": "Rice Racing",
      "vendor": "Rice Racing",
      "extraResources": [
        {
          "from": "build/backend-linux-${arch}",
          "to": "backend"
        }
      ],
      "desktop": {
        "entry": {
          "Name": "ACCC Telemetry",
          "Comment": "ACC Console Telemetry \u2014 analyze racing recordings locally",
          "StartupWMClass": "accc-telemetry"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "fpm": [
        "--url",
        "https://github.com/SaberDinp/ACCCT"
      ],
      "depends": [
        "libc6 (>= 2.28)",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libstdc++6",
        "libgcc-s1 | libgcc1",
        "zlib1g",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libudev1",
        "libxkbcommon0",
        "libcups2t64 | libcups2"
      ]
    },
    "rpm": {
      "fpm": [
        "--url",
        "https://github.com/SaberDinp/ACCCT",
        "--rpm-compression-level",
        "5"
      ],
      "depends": [
        "glibc >= 2.28",
        "(gtk3 or libgtk-3-0)",
        "(libnotify or libnotify4)",
        "(nss or mozilla-nss)",
        "(libXScrnSaver or libXss1)",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "(libstdc++ or libstdc++6)",
        "(libgcc or libgcc_s1)",
        "(zlib or libz1)",
        "(alsa-lib or libasound2)",
        "(mesa-libgbm or libgbm1)",
        "(systemd-libs or libudev1)",
        "(libxkbcommon or libxkbcommon0)",
        "(cups-libs or libcups2)"
      ],
      "compression": "gzip"
    },
    "appImage": {
      "executableArgs": []
    },
    "toolsets": {
      "appimage": "1.0.3"
    }
  },
  "homepage": "https://github.com/SaberDinp/ACCCT",
  "desktopName": "accc-telemetry.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaberDinp/ACCCT.git"
  }
}
